# PRODUCTION ENVIRONMENT TEMPLATE
# Copy this to .env.production for production deployment
# DO NOT commit actual .env.production with real secrets to version control

# Environment
NODE_ENV=production
PORT=5000

# CORS - Comma-separated origins allowed to access the API
# Replace with your actual frontend domain(s)
CORS_ORIGIN=https://yourlab.com,https://www.yourlab.com

# JWT Secrets - Generate strong secrets using: openssl rand -base64 32
# These should be provided via Docker secrets in production
JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access_secret
JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database - Use Docker secrets for credentials
DATABASE_URL=postgresql://diaglab:$(cat /run/secrets/postgres_password)@postgres:5432/diaglab

# Redis - Use Docker secrets for credentials
REDIS_URL=redis://:$(cat /run/secrets/redis_password)@redis:6379

# Encryption Keys - Generate strong secrets using: openssl rand -base64 32
# These should be provided via Docker secrets in production
REPORT_ENCRYPTION_KEY_FILE=/run/secrets/report_encryption_key
PHI_ENCRYPTION_KEY_FILE=/run/secrets/phi_encryption_key

# Public URLs - Replace with actual production domain
PUBLIC_VERIFY_BASE_URL=https://yourlab.com/verify
PUBLIC_API_BASE_URL=https://api.yourlab.com
PUBLIC_WEB_BASE_URL=https://yourlab.com
PUBLIC_SMART_REPORT_BASE_URL=https://yourlab.com/r

# Demo User - DISABLE in production
AUTH_SEED_DEMO_USER=false
AUTH_SEED_TENANT_ID=
AUTH_SEED_EMAIL=
AUTH_SEED_PASSWORD=

# Stripe (if using payments) - Use Docker secrets
STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret

# Twilio (if using WhatsApp/SMS) - Configure with real credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Payment Reconciliation
PAYMENT_RECONCILIATION_CRON=*/10 * * * *
JOB_RETRY_CRON=*/5 * * * *

# HL7/ASTM Analyzer
ANALYZER_TCP_PORT=5055
ANALYZER_DEFAULT_TENANT_ID=
ANALYZER_GATEWAY_ENABLED=true
ANALYZER_SYSTEM_USER_ID=ANALYZER_GATEWAY

# SaaS Configuration
SAAS_ROOT_DOMAIN=yourlab.com
SAAS_IGNORE_SUBDOMAINS=www,api

# Cookie Security
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.yourlab.com
COOKIE_PATH=/
REFRESH_COOKIE_MAX_AGE_MS=604800000

# AWS S3 (if using S3 for reports)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REPORT_PRESIGN_EXPIRES_SEC=900

# AI Co-Pathologist (optional)
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_PATIENT_SUMMARY_IN_PDF=false
AI_PATIENT_SUMMARY_LANGUAGE=en

# WhatsApp Cloud API (optional)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_TENANT_ID=
WHATSAPP_API_VERSION=v21.0

# BYOD Kiosk
KIOSK_UPI_VPA=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Analytics
ANALYTICS_CACHE_TTL_SEC=60

# TAT SLA
TAT_SLA_HOURS=24

# Logging
LOG_LEVEL=info

# Inventory Alerts
INVENTORY_ALERT_EMAIL=
INVENTORY_ALERT_WEBHOOK_URL=

# Report Distribution
REPORT_DISTRIBUTION_WEBHOOK_URL=
