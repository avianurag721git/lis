NODE_ENV=development
PORT=5000
# Comma-separated; include both if you use Vite on localhost and 127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Docker Compose default (run: docker compose up -d postgres redis)
DATABASE_URL=postgresql://diaglab:diaglab@localhost:5432/diaglab
REDIS_URL=redis://localhost:6379
# Demo login + tenant list (default on in development; set false to disable)
AUTH_SEED_DEMO_USER=true
PAYMENT_RECONCILIATION_CRON=*/10 * * * *
