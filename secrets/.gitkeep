# This directory is for Docker secrets in production
# DO NOT commit actual secrets to version control
# 
# For local development, use backend/.env instead
#
# For production deployment:
# 1. Generate strong secrets using: openssl rand -base64 32
# 2. Place each secret in a file named below (without .example extension)
# 3. Files will be mounted as Docker secrets in docker-compose.yml
#
# Required secrets:
# - postgres_password.txt
# - redis_password.txt
# - jwt_access_secret.txt
# - jwt_refresh_secret.txt
# - report_encryption_key.txt
# - phi_encryption_key.txt
#
# Optional secrets (for integrations):
# - stripe_secret_key.txt
# - stripe_webhook_secret.txt
